<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:roundIcon="@drawable/ic_launcher"
        android:label="Whisper Captions 2"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name="pl.whisperfiles.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="pl.whisperfiles.TeleprompterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="pl.whisperfiles.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="pl.whisperfiles.SubtitleEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="pl.whisperfiles.TranscriptEditorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <service
            android:name="pl.whisperfiles.TranscriptionService"
            android:exported="false" />

        <service
            android:name="pl.whisperfiles.SubtitleBurnService"
            android:exported="false" />
    </application>
</manifest>
